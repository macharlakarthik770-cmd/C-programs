#include <stdio.h>

int main() {
    int d, m, y, max_days;
    scanf("%d%d%d", &d, &m, &y);

    if (m >= 1 && m <= 12) {
        switch (m) {
            case 1: case 3: case 5: case 7: case 8: case 10: case 12:
                max_days = 31;
                break;
            case 4: case 6: case 9: case 11:
                max_days = 30; 
                break;
            case 2:
                if ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0)
                    max_days = 29;
                else
                    max_days = 28;
                break;
        }
        
        if (d >= 1 && d <= max_days)
            printf("valid");
        else
            printf("invalid");
    } else {
        
        printf("invalid"); 
    }

    return 0;
    }
