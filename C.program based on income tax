#include<stdio.h>
int main()
{
    int income,tax;
    scanf("%d",&income);
    if(income<=250000)
    tax=income*0;
    else if(income<=500000)
    tax=0.05*(income-250000)+250000*0;
    else if(income<=1000000)
    tax=250000*0+250000*0.05+(income-500000)*0.2;
    else
    tax=250000*0+250000*0.05+500000*0.2+(income-1000000)*0.3;
    printf("%d",tax);
    return 0;
    }
